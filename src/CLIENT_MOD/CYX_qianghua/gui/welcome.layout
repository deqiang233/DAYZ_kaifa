FrameWidgetClass RootFrame {
 visible 1
 position 0 0
 size 1 1
 halign center_ref
 valign center_ref
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  PanelWidgetClass BackgroundPanel {
   visible 1
   ignorepointer 0
   color 0 0 0 0.8
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   priority 10
   {
    FrameWidgetClass MainFrame {
     visible 1
     clipchildren 0
     ignorepointer 1
     position 0 0
     size 600 400
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     {
      PanelWidgetClass ContentPanel {
       visible 1
       clipchildren 0
       ignorepointer 1
       color 0.1 0.1 0.1 0.95
       position 0 0
       size 1 1
       halign center_ref
       valign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 0
       {
        TextWidgetClass TitleText {
         visible 1
         ignorepointer 1
         position 0 50
         size 1 80
         halign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 0
         vexactsize 1
         text "欢迎打开工作台"
         "text halign" center
         "text valign" center
         font "gui/fonts/etelkatextpro"
         "exact text" 1
         "exact text size" 48
         "size to text h" 0
         "size to text v" 0
        }
        TextWidgetClass SubtitleText {
         visible 1
         ignorepointer 1
         position 0 150
         size 1 40
         halign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 0
         vexactsize 1
         text "这是一个简单的界面示例"
         "text halign" center
         "text valign" center
         font "gui/fonts/etelkatextpro"
         "exact text" 1
         "exact text size" 28
         "size to text h" 0
         "size to text v" 0
        }
        ButtonWidgetClass CloseButton {
         visible 1
         clipchildren 0
         position 0 -30
         size 200 50
         halign center_ref
         valign bottom_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         style Empty
         {
          PanelWidgetClass ButtonBackground {
           visible 1
           ignorepointer 1
           color 0.2 0.5 0.8 1
           size 1 1
           halign center_ref
           valign center_ref
           hexactpos 1
           vexactpos 1
           hexactsize 0
           vexactsize 0
          }
          TextWidgetClass CloseButtonText {
           visible 1
           ignorepointer 1
           size 1 1
           halign center_ref
           valign center_ref
           hexactpos 1
           vexactpos 1
           hexactsize 0
           vexactsize 0
           text "关闭 (按 \\ 或 ESC)"
           "text halign" center
           "text valign" center
           font "gui/fonts/etelkatextpro"
           "exact text" 1
           "exact text size" 24
           "size to text h" 0
           "size to text v" 0
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
