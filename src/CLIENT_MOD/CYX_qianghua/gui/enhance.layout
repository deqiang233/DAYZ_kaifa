         "text halign" center
         "text valign" center
         color 255 255 255 255
         font "gui/fonts/etelkatextpro"
         "exact text" 1
         "exact text size" 28
        }
        
        // 洗练材料列表容器
        WrapSpacerWidgetClass RefineMaterialsListContainer {
         visible 1
         ignorepointer 1
         position 30 350
         size 390 200
         halign left_ref
         valign top_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         {
          // 洗练材料项 - 石头
          TextWidgetClass RefineMaterialStoneText {
           visible 1
           ignorepointer 1
           position 0 0
           size 390 40
           halign left_ref
           hexactpos 1
           vexactpos 1
           hexactsize 1
           vexactsize 1
           text "石头: 0/0"
           "text halign" left
           "text valign" center
           color 255 255 255 255
           font "gui/fonts/etelkatextpro"
           "exact text" 1
           "exact text size" 24
          }
          
          // 洗练材料项 - 钉子
          TextWidgetClass RefineMaterialNailsText {
           visible 1
           ignorepointer 1
           position 0 50
           size 390 40
           halign left_ref
           hexactpos 1
           vexactpos 1
           hexactsize 1
           vexactsize 1
           text "钉子: 0/0"
           "text halign" left
           "text valign" center
           color 255 255 255 255
           font "gui/fonts/etelkatextpro"
           "exact text" 1
           "exact text size" 24
          }
          
          // 洗练材料项 - 苹果
          TextWidgetClass RefineMaterialAppleText {
           visible 1
           ignorepointer 1
           position 0 100
           size 390 40
           halign left_ref
           hexactpos 1
           vexactpos 1
           hexactsize 1
           vexactsize 1
           text "苹果: 0/0"
           "text halign" left
           "text valign" center
           color 255 255 255 255
           font "gui/fonts/etelkatextpro"
           "exact text" 1
           "exact text size" 24
          }
         }
        }
        
        // 按钮区域（在右侧面板内，居中，下移）
        FrameWidgetClass ButtonsPanel {
         visible 1
         clipchildren 0
         ignorepointer 1
         position 0 560
         size 350 230
         halign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         {
          // 开始强化按钮（无边框）
          ButtonWidgetClass EnhanceButton {
           visible 1
           clipchildren 0
           position 0 0
           size 350 60
           halign center_ref
           valign center_ref
           hexactpos 1
           vexactpos 1
           hexactsize 1
           vexactsize 1
           style Empty
           {
            TextWidgetClass EnhanceButtonText {
             visible 1
             ignorepointer 1
             size 1 1
             halign center_ref
             valign center_ref
             hexactpos 1
             vexactpos 1
             hexactsize 0
             vexactsize 0
             text "开始强化"
             "text halign" center
             "text valign" center
             color 255 255 255 255
             font "gui/fonts/etelkatextpro"
             "exact text" 1
             "exact text size" 28
            }
           }
          }
          
          // 取消强化按钮（无边框）
          ButtonWidgetClass CloseButtonEnhance {
           visible 1
           clipchildren 0
           position 0 80
           size 350 60
           halign center_ref
           valign center_ref
           hexactpos 1
           vexactpos 1
           hexactsize 1
           vexactsize 1
           style Empty
           {
            TextWidgetClass CloseButtonEnhanceText {
             visible 1
             ignorepointer 1
             size 1 1
             halign center_ref
             valign center_ref
             hexactpos 1
             vexactpos 1
             hexactsize 0
             vexactsize 0
             text "取消强化"
             "text halign" center
             "text valign" center
             color 255 255 255 255
             font "gui/fonts/etelkatextpro"
             "exact text" 1
             "exact text size" 28
            }
           }
          }
          
          // 洗练按钮（在强化界面中使用）
          ButtonWidgetClass RefineButton {
           visible 0
           clipchildren 0
           position 0 160
           size 350 60
           halign center_ref
           valign center_ref
           hexactpos 1
           vexactpos 1
           hexactsize 1
           vexactsize 1
           style Empty
           {
            TextWidgetClass RefineButtonText {
             visible 1
             ignorepointer 1
             size 1 1
             halign center_ref
             valign center_ref
             hexactpos 1
             vexactpos 1
             hexactsize 0
             vexactsize 0
             text "洗练武器"
             "text halign" center
             "text valign" center
             color 255 255 255 255
             font "gui/fonts/etelkatextpro"
             "exact text" 1
             "exact text size" 28
            }
           }
          }
         }
        }
       }
      }
      
      // 成功率文本（显示在中央框下方，左移，下移150像素）
      TextWidgetClass SuccessRateText {
       visible 1
       ignorepointer 1
       position -250 800
       size 600 40
       halign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "强化成功概率: 50%"
       "text halign" center
       "text valign" center
       color 255 255 255 255
       font "gui/fonts/etelkatextpro"
       "exact text" 1
       "exact text size" 24
      }
      
      // 洗练属性文本（显示在成功率下方，往下移更多避免重叠）
      TextWidgetClass RefineInfoText {
       visible 1
       ignorepointer 1
       position -250 900
       size 600 40
       halign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "当前洗练: 未洗练"
       "text halign" center
       "text valign" center
       color 255 255 0 255
       font "gui/fonts/etelkatextpro"
       "exact text" 1
       "exact text size" 24
      }
      
      // 警告文字（显示在成功率下方，左移，下移150像素）
      TextWidgetClass WarningText {
       visible 1
       ignorepointer 1
       position -250 850
       size 800 50
       halign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "注:强化前请清空装备上的配件等物品,以防被吞!!!"
       "text halign" center
       "text valign" center
       color 255 255 255 255
       font "gui/fonts/etelkatextpro"
       "exact text" 1
       "exact text size" 20
       wrap 1
      }
     }
    }
   }
  }
 }
}

