       halign right_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       {
        // 强化所需材料标题
        TextWidgetClass MaterialsTitleText {
         visible 1
         ignorepointer 1
         position 30 20
         size 450 50
         halign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         text "强化所需材料"
         "text halign" center
         "text valign" center
         color 255 255 255 255
         font "gui/fonts/etelkatextpro"
         "exact text" 1
         "exact text size" 28
        }
        
        // 材料列表容器
       FrameWidgetClass MaterialsListContainer {
        visible 1
        clipchildren 1
        ignorepointer 1
        position 30 80
        size 390 400
        halign left_ref
        valign top_ref
        hexactpos 1
        vexactpos 1
        hexactsize 1
        vexactsize 1
        {
         // 动态材料列表（用于显示其他材料）- 改为 FrameWidget 以支持绝对定位
         FrameWidgetClass MaterialsList {
          visible 1
          ignorepointer 1
          position 0 0
          size 390 400
          halign left_ref
          valign top_ref
          hexactpos 1
          vexactpos 1
          hexactsize 1
          vexactsize 1
         }
        }
       }
        
        // 保护区域容器
        WidgetClass ProtectionContainer {
         visible 1
         ignorepointer 1
         position 30 360
         size 390 80
         halign left_ref
         valign top_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         {
          CheckBoxWidgetClass UseProtectionCheckbox {
           visible 1
           ignorepointer 0
           position 0 0
           size 24 24
           hexactpos 1
           vexactpos 1
           hexactsize 1
           vexactsize 1
          }
          
          TextWidgetClass ProtectionStoneText {
           visible 1
           ignorepointer 1
           position 32 -4
           size 350 32
           halign left_ref
           hexactpos 1
           vexactpos 1
           hexactsize 1
           vexactsize 1
           text "保护石: 0/5"
           "text halign" left
           "text valign" center
           color 255 255 255 255
           font "gui/fonts/etelkatextpro"
           "exact text" 1
           "exact text size" 24
          }
         }
        }
        
        // 洗练所需材料标题
        TextWidgetClass RefineMaterialsTitleText {
         visible 1
         ignorepointer 1
