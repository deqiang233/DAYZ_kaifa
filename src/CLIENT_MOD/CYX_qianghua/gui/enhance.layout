FrameWidgetClass RootFrame {
 visible 1
 position 0 0
 size 1 1
 halign center_ref
 valign center_ref
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 0
 {
  // 全屏背景 - rgba(0,0,0,0.9) 更深的半透明黑色
  PanelWidgetClass EnhanceBackground {
   visible 1
   ignorepointer 0
   color 0 0 0 0.9
   position 0 0
   size 1 1
   halign left_ref
   valign top_ref
   hexactpos 1
   vexactpos 1
   hexactsize 0
   vexactsize 0
   priority 10
   style rover_sim_colorable
   {
    FrameWidgetClass MainPanel {
     visible 1
     clipchildren 0
     ignorepointer 1
     position 0 0
     size 1 1
     halign left_ref
     valign top_ref
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     {
      // 顶部左侧 - 装备强化（无边框）
      TextWidgetClass LeftTitleText {
       visible 1
       ignorepointer 1
       position 50 30
       size 200 60
       halign left_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "装备强化"
       "text halign" center
       "text valign" center
       color 255 255 255 255
       font "gui/fonts/etelkatextpro"
       "exact text" 1
       "exact text size" 32
      }
      
      // 顶部中间标题 - CYX强化系统 CoCo制作（红色文字）
      TextWidgetClass CenterTitleText {
       visible 1
       ignorepointer 1
       position 0 30
       size 1 60
       halign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 0
       vexactsize 1
       text "CYX强化系统 CoCo制作"
       "text halign" center
       "text valign" center
       color 255 255 255 255 
       font "gui/fonts/etelkatextpro"
       "exact text" 1
       "exact text size" 32
      }
      

      
      // 中央装备显示区域（无边框，整体左移）
      FrameWidgetClass ItemPreviewFrame {
       visible 1
       clipchildren 1
       ignorepointer 1
       position -250 120
       size 1000 600
       halign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       {
        // 装备名字（左上角）
        TextWidgetClass ItemNameLabel {
         visible 1
         ignorepointer 1
         position 50 30
         size 250 40
         halign left_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         text "装备名字"
         "text halign" left
         "text valign" center
         color 255 255 255 255
         font "gui/fonts/etelkatextpro"
         "exact text" 1
         "exact text size" 28
        }
        
        // 物品名称文本（动态显示）
        TextWidgetClass ItemNameText {
         visible 1
         ignorepointer 1
         position 250 30
         size 500 40
         halign left_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         text ""
         "text halign" left
         "text valign" center
         color 255 255 255 255
         font "gui/fonts/etelkatextpro"
         "exact text" 1
         "exact text size" 28
        }
        
        // 装备显示位置（中心提示）
        TextWidgetClass ItemDisplayPositionLabel {
         visible 1
         ignorepointer 1
         position 0 150
         size 800 50
         halign center_ref
         valign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         text "装备显示位置"
         "text halign" center
         "text valign" center
         color 255 255 255 255
         font "gui/fonts/etelkatextpro"
         "exact text" 1
         "exact text size" 32
        }
        
        // 物品预览（覆盖在"装备显示位置"上，放大50%）
        ItemPreviewWidgetClass ItemPreview {
         visible 1
         ignorepointer 1
         position 0 50
         size 900 450
         halign center_ref
         valign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         modelpos "0.0 0.0 0.0"
         modelorient "0.0 0.0 0.0"
         camerapos "0.0 0.0 0.0"
         cameraorient "0.0 0.0 0.0"
         fov 0.5
         "auto_size" 1
        }
       }
      }
      
      // 右侧材料面板（无边框，右移）
      FrameWidgetClass MaterialsPanel {
       visible 1
       clipchildren 0
       ignorepointer 1
       position 100 120
